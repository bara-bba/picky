<Window x:Class="ScreenSnap.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b"
                                Background="{StaticResource Brush.Subtle}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Brush.App}"
            Padding="14">
        <StackPanel>
            <!-- Tools -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <ToggleButton Name="SelectTool" Content="⭶ Select" Style="{StaticResource ToolToggle}"
                              Tag="Select" Checked="Tool_Checked" Unchecked="Tool_Unchecked" />
                <ToggleButton Name="ArrowTool" Content="↗ Arrow" Style="{StaticResource ToolToggle}"
                              Tag="Arrow" Checked="Tool_Checked" Unchecked="Tool_Unchecked" />
                <ToggleButton Name="RectTool" Content="▭ Rectangle" Style="{StaticResource ToolToggle}"
                              Tag="Rectangle" Checked="Tool_Checked" Unchecked="Tool_Unchecked" />
                <ToggleButton Name="TextTool" Content="A Text" Style="{StaticResource ToolToggle}"
                              Tag="Text" Checked="Tool_Checked" Unchecked="Tool_Unchecked" />

                <Border Width="1" Background="{StaticResource Brush.Stroke}" Margin="6,2,10,2" />

                <Button Name="DeleteButton" Content="🗑 Delete" Click="Delete_Click"
                        Style="{StaticResource SubtleButton}" Padding="12,6" Margin="0,0,6,0" />
                <Button Name="UndoButton" Content="⟲ Undo" Click="Undo_Click"
                        Style="{StaticResource SubtleButton}" Padding="12,6" />
            </StackPanel>

            <!-- Contextual properties (fixed height so the bar doesn't jump between tools) -->
            <StackPanel Orientation="Horizontal" Height="32" Margin="0,0,0,12" VerticalAlignment="Center">
                <StackPanel Name="ColorGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Color" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Name="ShapeGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Background="{StaticResource Brush.Stroke}" Margin="12,2,12,2" />
                    <TextBlock Text="Thickness" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Name="ThicknessCombo" Style="{StaticResource DarkCombo}" Width="52"
                              VerticalAlignment="Center" SelectionChanged="Thickness_Changed">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Name="TextGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Background="{StaticResource Brush.Stroke}" Margin="12,2,12,2" />
                    <TextBlock Text="Font" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Name="FontCombo" Style="{StaticResource DarkCombo}" Width="150"
                              VerticalAlignment="Center" SelectionChanged="Font_Changed" />
                    <TextBlock Text="Size" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <ComboBox Name="TextSizeCombo" Style="{StaticResource DarkCombo}" Width="56"
                              VerticalAlignment="Center" SelectionChanged="TextSize_Changed">
                        <ComboBoxItem>12</ComboBoxItem>
                        <ComboBoxItem>16</ComboBoxItem>
                        <ComboBoxItem>20</ComboBoxItem>
                        <ComboBoxItem>28</ComboBoxItem>
                        <ComboBoxItem>40</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <Border CornerRadius="4"
                    ClipToBounds="True"
                    BorderBrush="{StaticResource Brush.Stroke}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Grid Name="EditorSurface">
                    <Image Name="PreviewImage"
                           Stretch="Uniform"
                           MaxWidth="900"
                           MaxHeight="600" />
                    <Canvas Name="AnnotationCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp" />
                </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Name="SavedPathText"
                           Foreground="{StaticResource Brush.TextTertiary}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="2,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="OpenFolderButton"
                            Content="Open folder"
                            Click="OpenFolderButton_Click"
                            Style="{StaticResource SubtleButton}"
                            Padding="14,6"
                            Margin="0,0,8,0" />
                    <Button Name="CopyButton"
                            Content="Copy"
                            Click="CopyButton_Click"
                            Style="{StaticResource SubtleButton}"
                            Padding="14,6"
                            Margin="0,0,8,0" />
                    <Button Name="SaveButton"
                            Content="Save As…"
                            Click="SaveButton_Click"
                            Style="{StaticResource AccentButton}"
                            Padding="14,6" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
