<Window x:Class="ScreenSnap.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
    <Canvas Name="RootCanvas"
            MouseDown="Canvas_MouseDown"
            MouseMove="Canvas_MouseMove"
            MouseUp="Canvas_MouseUp">
        <Image Name="Frozen"
               Canvas.Left="0"
               Canvas.Top="0"
               Stretch="Fill" />
        <Rectangle Name="Dim"
                   Fill="#66000000" />
        <Rectangle Name="SelectionRect"
                   StrokeThickness="1.5"
                   Visibility="Collapsed" />
        <TextBlock Name="HintText"
                   Text="Click a window to grab it  •  Drag to select a region  •  Esc to cancel"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   FontSize="14"
                   Canvas.Left="16"
                   Canvas.Top="16" />
    </Canvas>
</Window>
