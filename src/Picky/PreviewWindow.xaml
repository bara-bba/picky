<Window x:Class="Picky.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b"
                                Background="{StaticResource Brush.Subtle}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Brush.App}"
            Padding="14">
        <DockPanel>
            <!-- Left toolbar -->
            <StackPanel DockPanel.Dock="Left" Width="158" Margin="0,0,14,0">
                <ToggleButton Name="RectTool" Content="▭  Rectangle" Style="{StaticResource ToolToggle}"
                              Tag="Rectangle" Checked="Tool_Checked" Unchecked="Tool_Unchecked" />
                <ToggleButton Name="ArrowTool" Content="↗  Arrow" Style="{StaticResource ToolToggle}"
                              Tag="Arrow" Checked="Tool_Checked" Unchecked="Tool_Unchecked" />
                <ToggleButton Name="TextTool" Content="A  Text" Style="{StaticResource ToolToggle}"
                              Tag="Text" Checked="Tool_Checked" Unchecked="Tool_Unchecked" />
                <ToggleButton Name="SelectTool" Content="⭶  Select" Style="{StaticResource ToolToggle}"
                              Tag="Select" Checked="Tool_Checked" Unchecked="Tool_Unchecked" />

                <Border Height="1" Background="{StaticResource Brush.Stroke}" Margin="0,6,0,10" />

                <Button Name="DeleteButton" Content="🗑  Delete" Click="Delete_Click"
                        Style="{StaticResource SubtleButton}" Padding="12,7"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button Name="UndoButton" Content="⟲  Undo" Click="Undo_Click"
                        Style="{StaticResource SubtleButton}" Padding="12,7"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />

                <Border Height="1" Background="{StaticResource Brush.Stroke}" Margin="0,10,0,10" />

                <StackPanel Name="ColorGroup">
                    <TextBlock Text="Color" Style="{StaticResource PropLabel}" />
                    <WrapPanel Name="SwatchPanel" Margin="0,0,0,4" />
                </StackPanel>

                <!-- Fixed-height slot reserved for the tallest (Text) properties, so the
                     toolbar height stays constant no matter which tool is active. -->
                <Grid Height="120" Margin="0,10,0,0">
                    <StackPanel Name="ShapeGroup" VerticalAlignment="Top">
                        <TextBlock Text="Thickness" Style="{StaticResource PropLabel}" />
                        <ComboBox Name="ThicknessCombo" Style="{StaticResource DarkCombo}"
                                  HorizontalAlignment="Stretch" SelectionChanged="Thickness_Changed">
                            <ComboBoxItem>1</ComboBoxItem>
                            <ComboBoxItem>2</ComboBoxItem>
                            <ComboBoxItem>3</ComboBoxItem>
                            <ComboBoxItem>5</ComboBoxItem>
                            <ComboBoxItem>8</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Name="TextGroup" VerticalAlignment="Top">
                        <TextBlock Text="Font" Style="{StaticResource PropLabel}" />
                        <ComboBox Name="FontCombo" Style="{StaticResource DarkCombo}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,8" SelectionChanged="Font_Changed" />
                        <TextBlock Text="Size" Style="{StaticResource PropLabel}" />
                        <ComboBox Name="TextSizeCombo" Style="{StaticResource DarkCombo}"
                                  HorizontalAlignment="Stretch" SelectionChanged="TextSize_Changed">
                            <ComboBoxItem>12</ComboBoxItem>
                            <ComboBoxItem>16</ComboBoxItem>
                            <ComboBoxItem>20</ComboBoxItem>
                            <ComboBoxItem>28</ComboBoxItem>
                            <ComboBoxItem>40</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Bottom action bar -->
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Name="SavedPathText"
                           Foreground="{StaticResource Brush.TextTertiary}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="2,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="OpenFolderButton"
                            Content="Open folder"
                            Click="OpenFolderButton_Click"
                            Style="{StaticResource SubtleButton}"
                            Padding="14,6"
                            Margin="0,0,8,0" />
                    <Button Name="CopyButton"
                            Content="Copy"
                            Click="CopyButton_Click"
                            Style="{StaticResource SubtleButton}"
                            ToolTip="Copy the annotated image to the clipboard  (Ctrl+C)"
                            Padding="14,6"
                            Margin="0,0,8,0" />
                    <Button Name="SaveButton"
                            Content="Save As…"
                            Click="SaveButton_Click"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Save to a new file.  Ctrl+S saves over the original and closes."
                            Padding="14,6" />
                </StackPanel>
            </Grid>

            <!-- Image + annotation surface -->
            <Border CornerRadius="4"
                    ClipToBounds="True"
                    BorderBrush="{StaticResource Brush.Stroke}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid Name="EditorSurface">
                    <Image Name="PreviewImage"
                           Stretch="Uniform"
                           MaxWidth="820"
                           MaxHeight="600" />
                    <Canvas Name="AnnotationCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp" />
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
