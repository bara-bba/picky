<Window x:Class="Picky.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="False"
        KeyDown="Window_KeyDown">

    <!--
      Layer order (all stretch to fill, so there is no manual DIP sizing to get wrong):
        Frozen    - the pre-overlay screenshot of the whole virtual desktop
        Dim       - uniform darkening
        Bright    - the same screenshot again, clipped to the selection, so the chosen
                    area reads at full brightness (a cut-out, not a lighter overlay)
        RootCanvas- transparent hit-test surface, selection outline, loupe, hint
    -->
    <Grid>
        <Image Name="Frozen" Stretch="Fill" />

        <Rectangle Name="Dim" Fill="#66000000" />

        <Image Name="Bright" Stretch="Fill" />

        <Canvas Name="RootCanvas"
                Background="Transparent"
                MouseDown="Canvas_MouseDown"
                MouseMove="Canvas_MouseMove"
                MouseUp="Canvas_MouseUp"
                MouseRightButtonUp="Canvas_MouseRightButtonUp">

            <Rectangle Name="SelectionRect"
                       StrokeThickness="1.5"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />

            <!--
              Pixel loupe. Follows the cursor and magnifies the frozen screenshot so individual
              pixels become addressable blocks: 15 source pixels across at 9 DIP each = a 135 square.
              Those numbers must stay in sync with LensPixels / LensCell in the code-behind, and the
              grid tile plus the centre-pixel marker are sized from them (margin 63 = 7 * 9, leaving
              exactly one 9x9 cell in the middle).
            -->
            <Border Name="LensPanel"
                    IsHitTestVisible="False"
                    Background="#E61C1C1C"
                    BorderBrush="#59FFFFFF"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="5"
                    Visibility="Collapsed">
                <StackPanel>
                    <Border ClipToBounds="True" Width="135" Height="135">
                        <Grid>
                            <!-- NearestNeighbor keeps magnified pixels as hard-edged blocks. -->
                            <Image Name="LensImage"
                                   Width="135"
                                   Height="135"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top">
                                <Image.RenderTransform>
                                    <TranslateTransform x:Name="LensOffset" />
                                </Image.RenderTransform>
                            </Image>

                            <!-- One-cell tile, so the grid lines land on real pixel boundaries. -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile"
                                                  Viewport="0,0,9,9"
                                                  ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="Transparent">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#33FFFFFF" Thickness="1" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,9,9" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Crosshair: 135 - 67 - 67 = 1 DIP wide, dead centre. -->
                            <Rectangle Margin="67,0,67,0" Fill="#B3FFFFFF" />
                            <Rectangle Margin="0,67,0,67" Fill="#B3FFFFFF" />

                            <!-- The exact pixel under the cursor. -->
                            <Rectangle Margin="63"
                                       Stroke="#FFE81123"
                                       StrokeThickness="1"
                                       Fill="Transparent" />
                        </Grid>
                    </Border>

                    <TextBlock Name="LensText"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Name="HintPanel"
                    IsHitTestVisible="False"
                    Background="#CC1F1F1F"
                    BorderBrush="#3D3D3D"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8">
                <TextBlock Name="HintText"
                           Text="Click a window to grab it  •  Drag to select a region  •  Esc to cancel"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="14" />
            </Border>
        </Canvas>
    </Grid>
</Window>
