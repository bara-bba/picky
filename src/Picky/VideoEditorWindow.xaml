<Window x:Class="Picky.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="picky — Video editor"
        Height="640"
        Width="920"
        MinHeight="460"
        MinWidth="640"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen"
        Focusable="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- video -->
            <RowDefinition Height="Auto" />
            <!-- timeline -->
            <RowDefinition Height="Auto" />
            <!-- transport + actions -->
        </Grid.RowDefinitions>

        <!-- Video surface -->
        <Border Grid.Row="0"
                Background="#FF101010"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <MediaElement Name="Player"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              ScrubbingEnabled="True"
                              Stretch="Uniform"
                              MediaOpened="Player_MediaOpened"
                              MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed" />

                <!-- Shown if WMF can't decode the clip; cutting + frame grab still work via ffmpeg. -->
                <TextBlock Name="PlaybackError"
                           Visibility="Collapsed"
                           Text="Can't preview this clip's codec — trimming and frame capture still work."
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Timeline: clickable track, marker ticks, shaded selection band, playhead -->
        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Height="44"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Stroke}"
                BorderThickness="1"
                CornerRadius="5">
            <Canvas Name="Timeline"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Timeline_MouseLeftButtonDown"
                    MouseMove="Timeline_MouseMove"
                    MouseLeftButtonUp="Timeline_MouseLeftButtonUp"
                    SizeChanged="Timeline_SizeChanged">
                <!-- Selection band (between the two active markers). -->
                <Rectangle Name="SelectionBand"
                           Height="42"
                           Canvas.Top="1"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />
                <!-- Playhead. -->
                <Rectangle Name="Playhead"
                           Width="2"
                           Height="42"
                           Canvas.Top="1"
                           Fill="{StaticResource Brush.TextPrimary}"
                           IsHitTestVisible="False" />
                <!-- Marker ticks are added in code. -->
            </Canvas>
        </Border>

        <!-- Transport + actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- play/pause -->
                <ColumnDefinition Width="Auto" />
                <!-- time -->
                <ColumnDefinition Width="*" />
                <!-- spacer -->
                <ColumnDefinition Width="Auto" />
                <!-- actions -->
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Name="PlayPauseButton"
                    Content="▶"
                    FontSize="16"
                    Width="40"
                    Height="34"
                    Padding="0"
                    Click="PlayPause_Click"
                    Style="{StaticResource SubtleButton}"
                    ToolTip="Play / pause (Space)"
                    Margin="0,0,10,0" />

            <TextBlock Grid.Column="1"
                       Name="TimeText"
                       Text="0:00.00 / 0:00.00"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       FontSize="12"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Name="MarkerButton"
                        Content="⚑ Marker"
                        Click="AddMarker_Click"
                        Style="{StaticResource SubtleButton}"
                        ToolTip="Drop a marker at the playhead (M)"
                        Margin="0,0,8,0" />
                <Button Name="FrameButton"
                        Content="⛶ Frame"
                        Click="GrabFrame_Click"
                        Style="{StaticResource SubtleButton}"
                        ToolTip="Save the current frame as a screenshot and open it in the editor"
                        Margin="0,0,8,0" />
                <Button Name="TrimButton"
                        Content="Keep selection"
                        Click="TrimSelection_Click"
                        Style="{StaticResource SubtleButton}"
                        ToolTip="Trim the clip down to the span between the two active markers"
                        IsEnabled="False"
                        Margin="0,0,8,0" />
                <Button Name="RemoveButton"
                        Content="Remove selection"
                        Click="RemoveSelection_Click"
                        Style="{StaticResource SubtleButton}"
                        ToolTip="Cut the span between the two active markers out and keep the rest"
                        IsEnabled="False"
                        Margin="0,0,8,0" />

                <Border Width="1"
                        Background="{StaticResource Brush.Stroke}"
                        Margin="2,2,10,2" />

                <Button Name="SaveButton"
                        Content="Save"
                        Click="Save_Click"
                        Style="{StaticResource AccentButton}"
                        ToolTip="Overwrite the original clip with your edits (Ctrl+S)"
                        IsEnabled="False"
                        Margin="0,0,8,0" />
                <Button Name="SaveCopyButton"
                        Content="Save a copy…"
                        Click="SaveCopy_Click"
                        Style="{StaticResource SubtleButton}"
                        ToolTip="Save your edits to a new file, keeping the original"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
