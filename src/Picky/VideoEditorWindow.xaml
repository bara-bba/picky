<Window x:Class="Picky.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="picky — Video editor"
        Height="640"
        Width="920"
        MinHeight="460"
        MinWidth="640"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen"
        Focusable="True">
    <Window.Resources>
        <!-- Toolbar icon: borderless, icon-font glyph, dimmed when disabled. -->
        <Style x:Key="EditorIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video surface -->
        <Border Grid.Row="0" Background="#FF101010" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <MediaElement Name="Player"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              ScrubbingEnabled="True"
                              Stretch="Uniform"
                              MediaOpened="Player_MediaOpened"
                              MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed" />
                <TextBlock Name="PlaybackError"
                           Visibility="Collapsed"
                           Text="Can't preview this clip's codec — editing and frame capture still work."
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Timeline: one block per kept segment, plus the playhead. Blocks are built in code. -->
        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Height="52"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Stroke}"
                BorderThickness="1"
                CornerRadius="5">
            <Canvas Name="Timeline"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Timeline_MouseLeftButtonDown"
                    MouseMove="Timeline_MouseMove"
                    MouseLeftButtonUp="Timeline_MouseLeftButtonUp"
                    SizeChanged="Timeline_SizeChanged">
                <Rectangle Name="Playhead"
                           Width="2"
                           Height="50"
                           Canvas.Top="0"
                           Panel.ZIndex="100"
                           Fill="{StaticResource Brush.TextPrimary}"
                           IsHitTestVisible="False" />
            </Canvas>
        </Border>

        <!-- Transport + actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Content is a filled vector triangle / bars, set in code. -->
            <Button Grid.Column="0"
                    Name="PlayPauseButton"
                    Width="34"
                    Height="30"
                    Click="PlayPause_Click"
                    Style="{StaticResource IconButton}"
                    ToolTip="Play / pause (Space)"
                    Margin="0,0,10,0" />

            <TextBlock Grid.Column="1"
                       Name="TimeText"
                       Text="0:00.00 / 0:00.00"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       FontSize="12"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Name="SplitButton" Content="&#xE8C6;" Click="Split_Click" Style="{StaticResource EditorIcon}"
                        ToolTip="Split the block at the playhead (M)" />
                <Button Name="DeleteButton" Content="&#xE74D;" Click="Delete_Click" Style="{StaticResource EditorIcon}"
                        ToolTip="Delete the selected blocks; the rest close up (Delete)" IsEnabled="False" />
                <Button Name="ExportButton" Content="&#xEDE1;" Click="Export_Click" Style="{StaticResource EditorIcon}"
                        ToolTip="Export the selected blocks to a new clip in the capture folder" IsEnabled="False" />
                <Button Name="FrameButton" Content="&#xE722;" Click="GrabFrame_Click" Style="{StaticResource EditorIcon}"
                        ToolTip="Save the current frame as a screenshot" />

                <Border Width="1" Background="{StaticResource Brush.Stroke}" Margin="6,2,10,2" />

                <Button Name="UndoButton" Content="&#xE7A7;" Click="Undo_Click" Style="{StaticResource EditorIcon}"
                        ToolTip="Undo (Ctrl+Z)" IsEnabled="False" />
                <Button Name="RedoButton" Content="&#xE7A6;" Click="Redo_Click" Style="{StaticResource EditorIcon}"
                        ToolTip="Redo (Ctrl+Y)" IsEnabled="False" />

                <Border Width="1" Background="{StaticResource Brush.Stroke}" Margin="6,2,10,2" />

                <Button Name="SaveButton" Content="&#xE74E;" Click="Save_Click" Style="{StaticResource EditorIcon}"
                        ToolTip="Save over the original clip (Ctrl+S)" IsEnabled="False" />
                <!-- Save a copy: the save glyph with a small arrow on its corner. -->
                <Button Name="SaveCopyButton" Click="SaveCopy_Click" Style="{StaticResource EditorIcon}"
                        ToolTip="Save a copy, keeping the original" IsEnabled="False" Margin="0">
                    <Grid Width="20" Height="18">
                        <TextBlock Text="&#xE74E;" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Text="&#xE72A;" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
