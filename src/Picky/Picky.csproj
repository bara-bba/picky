<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Picky</AssemblyName>
    <RootNamespace>Picky</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <!--
      Velopack must initialise before any UI, so we supply our own Main in Program.cs instead of the
      one WPF generates from App.xaml. StartupObject picks ours when both exist.
    -->
    <StartupObject>Picky.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Installer + delta auto-update. Also provides the `vpk` packaging CLI. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- Debug only: copy a local ffmpeg next to the app so recording works while developing.
       Release builds ship WITHOUT ffmpeg — it's a runtime prerequisite (winget install ffmpeg),
       which keeps the installer download small. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug' And Exists('tools\ffmpeg.exe')">
    <None Include="tools\ffmpeg.exe" Link="ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
