<Window x:Class="Picky.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Picky — Gallery"
        Height="620"
        Width="880"
        MinHeight="360"
        MinWidth="520"
        Background="{StaticResource Brush.App}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Captures"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <!-- Toolbar: actions on the left, folder path fills the remaining space on the right. -->
        <Grid Grid.Row="1" Margin="0,12,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left-click takes the default; right-click picks the mode. -->
            <Button Grid.Column="0"
                    Name="ScreenshotButton"
                    Content="⛶  Screenshot"
                    Click="Screenshot_Click"
                    Style="{StaticResource SubtleButton}"
                    ToolTip="Click to snip a region — right-click for full screen"
                    Margin="0,0,8,0">
                <Button.ContextMenu>
                    <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                        <MenuItem Header="Drag a region…" Click="ShotRegion_Click" />
                        <MenuItem Header="This screen" Click="ShotThisScreen_Click" />
                        <MenuItem Header="All screens" Click="ShotAllScreens_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Button Grid.Column="1"
                    Name="RecordButton"
                    Content="⏺  Record"
                    Click="Record_Click"
                    Style="{StaticResource SubtleButton}"
                    ToolTip="Click to record a region — right-click for full screen"
                    Margin="0,0,8,0">
                <Button.ContextMenu>
                    <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                        <MenuItem Header="Record a region…" Click="RecordRegion_Click" />
                        <MenuItem Header="Record this screen" Click="RecordScreen_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Border Grid.Column="2"
                    Width="1"
                    Background="{StaticResource Brush.Stroke}"
                    Margin="2,2,10,2" />

            <Button Grid.Column="3"
                    Content="Change folder…"
                    Click="ChangeFolder_Click"
                    Style="{StaticResource SubtleButton}"
                    Width="118"
                    Margin="0,0,8,0" />
            <Button Grid.Column="4"
                    Content="Open folder"
                    Click="OpenFolder_Click"
                    Style="{StaticResource SubtleButton}"
                    Width="118"
                    Margin="0,0,8,0" />
            <Button Grid.Column="5"
                    Content="Refresh"
                    Click="RefreshButton_Click"
                    Style="{StaticResource SubtleButton}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="6"
                    Content="⚙  Preferences"
                    Click="Preferences_Click"
                    Style="{StaticResource SubtleButton}"
                    Margin="0,0,10,0" />

            <Border Grid.Column="7"
                    Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Stroke}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,0"
                    VerticalAlignment="Stretch">
                <TextBlock Name="FolderPathText"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox Name="ThumbnailList"
                     SelectionMode="Extended"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Focusable="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="Thumbnail_DoubleClick"
                     SelectionChanged="ThumbnailList_SelectionChanged"
                     PreviewKeyDown="ThumbnailList_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="ThumbnailList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ThumbnailList_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="ThumbnailList_PreviewMouseLeftButtonUp"
                     PreviewMouseRightButtonDown="ThumbnailList_PreviewMouseRightButtonDown"
                     ContextMenuOpening="ThumbnailList_ContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                        <MenuItem Name="RenameMenuItem" Header="Rename…" Click="Rename_Click" />
                        <MenuItem Header="Copy image" InputGestureText="Ctrl+C" Click="CopyImage_Click" />
                        <MenuItem Header="Copy file" InputGestureText="Ctrl+Shift+C" Click="CopyFile_Click" />
                        <MenuItem Header="Copy path" Click="CopyPath_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Name="CardBorder"
                                            Background="{StaticResource Brush.Card}"
                                            BorderBrush="{StaticResource Brush.Stroke}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Brush.CardHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="240">
                            <Border CornerRadius="4,4,0,0"
                                    Background="#FF1B1B1B"
                                    Height="150"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           Margin="6" />

                                    <!-- Play affordance, so a clip is obviously a clip. -->
                                    <Border Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Background="#B0000000"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Path Data="M 0,0 L 12,7 L 0,14 Z"
                                              Fill="White"
                                              Margin="3,0,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <Border Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                            Background="#C0000000"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,0,8,8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding DurationText}"
                                                   Foreground="White"
                                                   FontSize="11" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="10,8,10,9">
                                <TextBlock Text="{Binding FileName}"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TimeText}"
                                           Foreground="{StaticResource Brush.TextTertiary}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Rubber-band marquee overlay; never eats mouse input itself. -->
            <Canvas Name="MarqueeCanvas" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Name="MarqueeRect"
                           Visibility="Collapsed"
                           Stroke="{DynamicResource Brush.Accent}"
                           StrokeThickness="1" />
            </Canvas>

            <TextBlock Name="EmptyState"
                       Text="No captures yet. Use the tray icon or control panel to take one."
                       Foreground="{StaticResource Brush.TextTertiary}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,60,0,0"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
